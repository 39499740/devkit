```ts
const FAV_KEY = 'devkit.favorites.v1'

export interface FavoriteEntry {
  id: string
  /** ISO 收藏时间；旧数据可能为 null（未记录时间） */
  at: string | null
}

interface FavStore {
  v: 2
  items: FavoriteEntry[]
}

function load(): FavoriteEntry[] {
  if (import.meta.server) return []
  try {
    const raw = localStorage.getItem(FAV_KEY)
    if (!raw) return []
    const parsed = JSON.parse(raw)
    if (Array.isArray(parsed)) {
      return parsed.filter((x) => typeof x === 'string').map((id) => ({ id, at: null }))
    }
    if (parsed && Array.isArray(parsed.items)) {
      return parsed.items
        .filter((x: any) => x && typeof x.id === 'string')
        .map((x: any) => ({ id: x.id, at: typeof x.at === 'string' ? x.at : null }))
    }
    return []
  } catch {
    return []
  }
}

export function useFavorites() {
  const entries = useState<FavoriteEntry[]>('devkit-favorites-entries', load)
  const loaded = useState<boolean>('devkit-favorites-loaded', () => false)

  onMounted(...)

  const ids = computed(() => entries.value.map((e) => e.id))

  function persist() {
    localStorage.setItem(FAV_KEY, JSON.stringify({ v: 2, items: entries.value }))
  }

  function isFav(id) { return computed(() => ids.value.includes(id)) }

  function addedAt(id) { return entries.value.find((e) => e.id === id)?.at ?? null }

  function toggle(id) {
    if (entries.value.some((e) => e.id === id)) {
      entries.value = entries.value.filter((e) => e.id !== id)
    } else {
      entries.value = [...entries.value, { id, at: new Date().toISOString() }]
    }
    persist()
  }

  function remove(id) { ... }
  function clear() { ... }

  return { entries, ids, isFav, addedAt, toggle, remove, clear }
}
```

