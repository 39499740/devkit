grouped display structure:
```
interface Group { key: string; label: string; icon: string; rows: Row[] }

const groups = computed<Group[]>(() => {
  const out: Group[] = []
  if (groupMode.value === 'time') {
    const g = recent.grouped.value
    if (g.today.length) out.push({ key: 'today', label: '今天', icon: 'clock', rows: rowsFor(g.today) })
    if (g.earlier.length) out.push({ key: 'earlier', label: '更早', icon: 'history', rows: rowsFor(g.earlier) })
  } else {
    const order = categories.map((c) => c.key)
    for (const c of categories) {
      const list = recent.entries.value.filter((e) => getToolById(e.id)?.cat === c.key)
      if (list.length) out.push({ key: c.key, label: c.name, icon: 'grid', rows: rowsFor(list) })
    }
    // 未识别分类
    const unknown = recent.entries.value.filter((e) => !getToolById(e.id))
    if (unknown.length) out.push({ key: 'unknown', label: '已不可用', icon: 'info', rows: rowsFor(unknown) })
  }
  return out
})
```

