DkSegmented template:

```vue
<template>
  <div
    ref="root"
    class="dk-seg"
    :class="`dk-seg--${size}`"
    role="radiogroup"
    :aria-label="ariaLabel || label"
    @keydown="onKeydown"
  >
    <button
      v-for="(o, i) in options"
      :key="o.value"
      type="button"
      role="radio"
      :aria-checked="modelValue === o.value"
      :tabindex="i === activeIndex ? 0 : -1"
      class="dk-seg__item"
      :class="{ 'dk-seg__item--active': modelValue === o.value }"
      :title="o.title"
      @click="select(o.value)"
    >
      {{ o.label }}
    </button>
  </div>
</template>
```

Script:
```ts
const props = withDefaults(
  defineProps<{
    modelValue: string
    options: SegmentOption[]
    size?: 'sm' | 'md'
    label?: string
    ariaLabel?: string
  }>(),
  { size: 'md' }
)
const emit = defineEmits<{ (e: 'update:modelValue', v: string): void }>()

const root = ref<HTMLElement | null>(null)
const activeIndex = computed(() => {
  const i = props.options.findIndex((o) => o.value === props.modelValue)
  return i >= 0 ? i : 0
})

function select(value: string) {
  emit('update:modelValue', value)
}

function focusAt(index: number) {
  const items = root.value?.querySelectorAll<HTMLButtonElement>('.dk-seg__item')
  items?.[index]?.focus()
}

function moveTo(index: number) {
  const n = props.options.length
  if (n === 0) return
  const next = ((index % n) + n) % n
  emit('update:modelValue', props.options[next].value)
  focusAt(next)
}

function onKeydown(e: KeyboardEvent) {
  if (props.options.length === 0) return
  switch (e.key) {
    case 'ArrowRight':
    case 'ArrowDown':
      e.preventDefault()
      moveTo(activeIndex.value + 1)
      break
    case 'ArrowLeft':
    case 'ArrowUp':
      e.preventDefault()
      moveTo(activeIndex.value - 1)
      break
    case 'Home':
      e.preventDefault()
      moveTo(0)
      break
    case 'End':
      e.preventDefault()
      moveTo(props.options.length - 1)
      break
  }
}
```

Wait: `focusAt` query uses class `.dk-seg__item` scoped CSS — class names are preserved (scoped adds data attr but class remains). querySelector works.

