But runtime-only Vue build doesn't support template compiler! `template` string won't compile. Use render function with h().

```js
const app = createApp({
  setup() {
    const v = ref('a')
    return () => h(DkSelect, {
      modelValue: v.value,
      'onUpdate:modelValue': (val) => { v.value = val },
      options: [{value:'a',label:'A'},{value:'b',label:'B'}],
      label: '测试标签'
    })
  }
})
app.mount(host)
await Promise.resolve()
const el = host.querySelector('select')
return { ariaLabel: el.getAttribute('aria-label'), id: el.id }
```

