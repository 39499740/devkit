Implementation:
```
function applyOpacity(a: number) {
  alpha.value = a
  const t = text.value.trim()
  // only rewrite if the source text carries alpha
  const p = parseColor(t)
  if (isRGBA(p) && p.a !== 1) {
    text.value = `${hex6.value}${hex2(Math.round(a*255))}`
  }
