function inferFromValues(values: unknown[], hint: string, path: string): string {
  const objVals = values.filter(v => isPlainObject(v))
  if (values.length > 0 && objVals.length === values.length) {
    // all plain objects
    return registerObject(objVals as Record<string, unknown>[], hint, path)
  }
  const types = values.map(v => infer(v, hint, path))
  return mergeTypes(types)
}
```
