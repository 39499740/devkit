I'll write helper:
```
function mergeTypes(types: string[]): string {
  const set: string[] = []
  for (const t of types) {
    for (const part of splitUnion(t)) if (!set.includes(part)) set.push(part)
  }
  if (set.length === 1) return set[0]
  // if contains unknown, unknown absorbs? TypeScript unknown | X = unknown
  if (set.includes('unknown')) return 'unknown'
  return set.join(' | ')
}
```
