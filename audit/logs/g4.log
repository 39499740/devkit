Now the array branch:
```
function inferArray(v: unknown[], hint: string, path: string): string {
  if (v.length === 0) {
    let auto = 'unknown[]'
    if (arrStrategy.value === 'any') auto = 'any[]'
    else if (arrStrategy.value === 'manual') {
      warnings.value.push(`${path}：空数组策略为“手动指定”，但未填写类型，暂用 unknown[]`)
    }
    addCandidate(path, arrStrategy.value === 'manual' ? '空数组：需手动指定元素类型' : '空数组：无元素可推断', auto)
    warnings.value.push(`${path}：空数组无法推断元素类型，已生成 ${auto}`)
    return auto
  }
  const nonNull = v.filter((x) => x !== null)
  const hasNull = nonNull.length !== v.length
  if (nonNull.length === 0) {
    addCandidate(path, '数组元素全为 null', 'unknown[]')
    warnings.value.push(`${path}：数组元素全为 null，无法推断，按 unknown[] 处理`)
    return 'unknown[]'
  }
  const allObj = nonNull.every(isPlainObject)
  const elemHint = /s$/i.test(hint) && hint.length > 1 ? hint.slice(0, -1) : hint + 'Item'
  let elem: string
  if (allObj) {
    const objs = nonNull as Record<string, unknown>[]
    if (objs.every(o => Object.keys(o).length === 0)) {
      elem = objStrategy.value === 'braces' ? '{}' : 'Record<string, unknown>'
      addCandidate(path, '数组元素均为空对象', `${elem}[]`)
      warnings.value.push(`${path}：数组元素均为空对象，按 ${elem} 处理`)
    } else {
      elem = registerObject(objs, elemHint, `${path}[]`)
    }
  } else {
    const types = nonNull.map((el) => infer(el, elemHint, `${path}[]`))
    if (unionStrategy.value === 'first') {
      elem = types[0] ?? 'unknown'
      if (splitUnion(mergeTypes(types)).length > 1) {
        addCandidate(path, '混合数组：已按“取首项类型”策略', wrapElem(elem))
        warnings.value.push(`${path}：数组元素类型不一致（${mergeTypes(types)}），按“取首项类型”仅保留 ${elem}`)
      }
    } else {
      const merged = mergeTypes(types)
      elem = merged
      const branches = splitUnion(merged)
      if (branches.length > 1) {
        addCandidate(path, `混合数组：${branches.join(' | ')}`, wrapElem(merged))
        warnings.value.push(`${path}：数组元素类型不一致，已生成联合类型 ${wrapElem(merged)}`)
      }
    }
  }
  if (hasNull && unionStrategy.value === 'union') {
    const branches = splitUnion(elem)
    if (!branches.includes('unknown') && !branches.includes('null')) {
      elem = mergeTypes([elem, 'null'])
    }
  }
  return wrapElem(elem)
}
```
