  const hex = rgba.a<1 ? compositeHex : baseHex
  return [
    { label: rgba.a<1 ? 'HEX（合成）':'HEX', value: hex },
    { label: 'HEX8', value: hex8 },
    { label: 'RGB', value: `rgb(${rgba.r}, ${rgba.g}, ${rgba.b})` },
    { label: 'RGBA', value: `rgba(${rgba.r}, ${rgba.g}, ${rgba.b}, ${round2(rgba.a)})` },
    { label: 'HSL', value: hslString(rgba) },
    { label: 'HSLA', value: hslaString(rgba) }
  ]
}
```
