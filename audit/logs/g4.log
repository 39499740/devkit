```
function val(n: number, unit: Unit): string {
  const zero = Object.is(n, 0) || Math.abs(n) < 1e-9
  if (zero && zeroUnit==='unitless') return '0'
  if (decimalMode==='fixed') return n.toFixed(decimals) + unit
  return String(parseFloat(n.toFixed(decimals))) + unit
}
```
