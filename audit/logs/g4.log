```
const lineInfos = computed(() => input.value.split('\n').map((text, index) => ({ index, text, tokens: scan(text) })))
const resultRows = computed(() => {
  if (baseError) return []
  const rows = []
  for (const li of lineInfos.value) {
    for (const tk of li.tokens) {
      const px = toPx(tk.num, tk.unit, root, parent)
      const isChecked = checked.value[li.index] !== false
      rows.push({
        key: li.index+':'+tk.start,
        lineIndex: li.index,
        checked: isChecked,
        raw: tk.raw,
        px: isChecked ? val(px,'px') : '—',
        rem: isChecked ? val(px/root,'rem') : '—',
        em: isChecked ? val(px/parent,'em') : '—'
      })
    }
  }
  return rows
})
```

