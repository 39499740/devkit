function formatsFor(rgba: RGBA, comp: RGBA): {label,value}[] {
  const compositeHex = '#'+hex2(comp.r)+hex2(comp.g)+hex2(comp.b)
  const baseHex = '#'+hex2(rgba.r)+hex2(rgba.g)+hex2(rgba.b)
