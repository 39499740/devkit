function useColorSide(initial: string) {
  const text = ref(initial)
  const alpha = ref(1)
  const parsed = computed(() => parseColor(text.value))
  const valid = computed(() => isRGBA(parsed.value))
  const rgba = computed<RGBA>(() => isRGBA(parsed.value) ? { ...parsed.value, a: alpha.value } : {r:0,g:0,b:0,a:alpha.value})
  watch(parsed, (p) => { if (isRGBA(p)) alpha.value = Math.round(p.a*100)/100 })
  const hex6 = computed(() => isRGBA(parsed.value) ? `#${hex2(...)}` : '#000000')
  const lastValid = ref(initial)
  watch(parsed, (p)=>{ if (isRGBA(p)) lastValid.value = text.value }, {immediate:true})
  function fromPicker(hex){ ... }
  function fromAlpha(a){ alpha.value=a; const p=parsed.value; if(isRGBA(p) && p.a<1){ text.value = a>=0.995?hex6.value:hex6.value+hex2(round(a*255)) } }
  return {text, alpha, parsed, valid, rgba, hex6, lastValid, fromPicker, fromAlpha}
}
```
