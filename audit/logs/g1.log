<template v-else-if="grouped.length">
  <div class="cat-page__groups">
    <section v-for="g in grouped" :key="g.title" class="cat-page__group">
      <div class="cat-page__group-head">
        <h2 class="cat-page__group-title">{{ g.title }}</h2>
        <span class="cat-page__group-note">{{ g.note }}</span>
