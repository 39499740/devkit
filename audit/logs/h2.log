```python
import json, sys
from playwright.sync_api import sync_playwright

BASE='http://127.0.0.1:3200'
results={'errors':[]}

with sync_playwright() as p:
    browser=p.chromium.launch()
    # ---- FOUC dark ----
    ctx=browser.new_context(color_scheme='light')
    ctx.add_init_script("""
      try{localStorage.setItem('devkit.prefs.v1', JSON.stringify({theme:'dark',codeFontSize:15,reduceMotion:true}))}catch(e){}
      window.__ff=null;
      requestAnimationFrame(function(){var e=document.documentElement;window.__ff={dark:e.classList.contains('dark'),size:getComputedStyle(e).getPropertyValue('--code-font-size').trim(),rm:e.classList.contains('reduce-motion')};});
    """)
    pg=ctx.new_page()
    pg.goto(BASE+'/', wait_until='domcontentloaded')
    pg.wait_for_function('window.__ff !== null', timeout=5000)
    ff=pg.evaluate('window.__ff')
    pg.wait_for_timeout(600)
    after=pg.evaluate("({dark:document.documentElement.classList.contains('dark'), bodyRm:document.body.classList.contains('reduce-motion'), size:getComputedStyle(document.documentElement).getPropertyValue('--code-font-size').trim(), bg:getComputedStyle(document.body).backgroundColor})")
    print('FOUC dark firstFrame=', ff)
    print('FOUC dark after   =', after)
    results['dark']=ff; results['darkAfter']=after
    ctx.close()

    # ---- FOUC light with OS dark ----
    ctx=browser.new_context(color_scheme='dark')
    ctx.add_init_script("""
      try{localStorage.setItem('devkit.prefs.v1', JSON.stringify({theme:'light',codeFontSize:13,reduceMotion:false}))}catch(e){}
      window.__ff=null;
      requestAnimationFrame(function(){var e=document.documentElement;window.__ff={dark:e.classList.contains('dark')};});
    """)
    pg=ctx.new_page()
    pg.goto(BASE+'/', wait_until='domcontentloaded')
    pg.wait_for_function('window.__ff !== null', timeout=5000)
    print('FOUC light(OS dark) firstFrame=', pg.evaluate('window.__ff'))
    results['light']=pg.evaluate('window.__ff')
    pg.wait_for_timeout(600)
    print('FOUC light after=', pg.evaluate("document.documentElement.classList.contains('dark')"))
    ctx.close()

    # ---- system theme (OS dark, no prefs) ----
    ctx=browser.new_context(color_scheme='dark')
    pg=ctx.new_page()
    pg.goto(BASE+'/', wait_until='domcontentloaded')
    pg.wait_for_timeout(400)
    print('system(OS dark) dark=', pg.evaluate("document.documentElement.classList.contains('dark')"))
    results['system']=pg.evaluate("document.documentElement.classList.contains('dark')")
    ctx.close()

    # ---- fonts ----
    ctx=browser.new_context()
    pg=ctx.new_page()
    reqs=[]
    pg.on('request', lambda r: reqs.append(r.url))
    pg.goto(BASE+'/', wait_until='load')
    pg.evaluate("() => document.fonts.load('16px \"Noto Sans SC\"', '中文测试')")
    ok=pg.evaluate("() => document.fonts.check('16px \"Noto Sans SC\"', '中')")
    fam=pg.evaluate("getComputedStyle(document.body).fontFamily")
    mono=pg.evaluate("getComputedStyle(document.querySelector('.mono') || document.body).fontFamily")
    google=[u for u in reqs if 'fonts.googleapis' in u or 'fonts.gstatic' in u]
    print('font family=', fam)
    print('document.fonts.check Chinese=', ok)
    print('google font requests=', google)
    results['fontCheck']=ok; results['google']=google
    ctx.close()
```

