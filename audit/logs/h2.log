<script setup lang="ts">
import { tools } from '~/data/tools'

useSeoMeta({ title: '离线与缓存状态 · DevKit' })

const online = ref(true)
const swSupported = ref(false)
const swRegistered = ref(false)
const swControlled = ref(false)
const swState = ref('')
