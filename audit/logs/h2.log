`refresh()`:
```ts
async function refresh(probe = false) {
  if (import.meta.server) return
  const nav = navigator
  swSupported.value = 'serviceWorker' in nav
  online.value = nav.onLine
  let registration: ServiceWorkerRegistration | null = null
  try {
    registration = swSupported.value ? (await nav.serviceWorker.getRegistration()) ?? null : null
  } catch { registration = null }
  swRegistered.value = !!registration
  swControlled.value = !!(nav.serviceWorker && nav.serviceWorker.controller)
  swState.value = registration?.active?.state ?? registration?.installing?.state ?? registration?.waiting?.state ?? ''
  ...
}
```

Reading caches:
```ts
let names: string[] = []
try { names = await caches.keys() } catch { names = [] }
cacheNames.value = names
let routes: string[] = []
let precache = 0
for (const name of names) {
  if (name === PAGE_CACHE) {
    try {
      const c = await caches.open(name)
      const keys = await c.keys()
      routes = keys.map((r) => new URL(r.url).pathname)
    } catch {}
  }
  if (name.startsWith(PRECACHE_PREFIX)) {
    try {
      const c = await caches.open(name)
      precache += (await c.keys()).length
    } catch {}
  }
}
cachedRoutes.value = routes
precacheCount.value = precache
```

Note workbox precache cache name in workbox 7 is `workbox-precache-v2-<scope>`.

