```
function parseField(raw, f) {
  const t = raw.trim().toUpperCase()
  if (!t) throw ...
  if (t === '?') {
    if (!f.quartz) throw new Error('Unix 五字段方言不支持 ?，请使用 *')
    if (f.kind !== 'dom' && f.kind !== 'dow') throw new Error(`? 只能用于「日」或「周」字段，不能用于「${f.name}」`)
    return { type: 'any' }
  }
  // Quartz dom/dow extensions
  if (f.kind === 'dom') {
    if (t === 'L') { if (!f.quartz) throw unixErr('L'); return { type:'domL' } }
    if (t === 'LW') { if (!f.quartz) throw unixErr('W'); return { type:'domLW' } }
    const mw = t.match(/^(\d{1,2})W$/)
    if (mw) { if (!f.quartz) throw unixErr('W'); ... }
  }
  ...
}
