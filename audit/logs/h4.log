```ts
interface Unrepresentable { line: number; col: number; char: string; cp: number; kind: string }

function kindOfChar(cp: number): string {
  if (cp >= 0x1f000 || (cp >= 0x2600 && cp <= 0x27bf) || (cp >= 0x1f300 && cp <= 0x1faff)) return 'emoji'
  if (cp >= 0x4e00 && cp <= 0x9fff) return '汉字'
  if (cp >= 0x3000 && cp <= 0x303f) return '中文标点'
  if (cp >= 0xff00 && cp <= 0xffef) return '全角字符'
  if (cp >= 0x0400 && cp <= 0x04ff) return '西里尔字母'
  return '符号 / 字符'
}

/** 目标编码为 ISO-8859-1 时，逐码点找出 > U+00FF 的字符并给出真实位置 */
function scanUnrepresentable(s: string): Unrepresentable[] {
  const list: Unrepresentable[] = []
  let line = 1
  let col = 0
  for (const ch of s) {
    if (ch === '\n') {
      line++
      col = 0
      continue
    }
    if (ch === '\r') continue
    col++
    const cp = ch.codePointAt(0)!
    if (cp > 0xff) list.push({ line, col, char: ch, cp, kind: kindOfChar(cp) })
  }
  return list
}

const latin1Only = computed(() => targetEnc.value === 'iso-8859-1')
const unrepresentable = computed(() => (latin1Only.value ? scanUnrepresentable(convertedText.value) : []))
```
Wait: for CRLF, the `\r` is skipped and doesn't increment col, and `\n` increments line and resets col. Good. For lone `\r` (CR newlines), it's skipped entirely, so columns on a CR-terminated line would be wrong. Hmm. Let me handle `\r` as line break too but avoid double count for CRLF. Simpler: iterate with index over the string and handle \r\n. Or normalize for scanning: since scanUnrepresentable only reports positions, I can treat `\r\n` and `\r` as line breaks. Let me do a manual loop:

```ts
function scanUnrepresentable(s: string): Unrepresentable[] {
  const list: Unrepresentable[] = []
  let line = 1
  let col = 0
  const chars = [...s]
  for (let i = 0; i < chars.length; i++) {
    const ch = chars[i]!
    if (ch === '\r' || ch === '\n') {
      if (ch === '\r' && chars[i + 1] === '\n') i++
      line++
      col = 0
      continue
    }
    col++
    const cp = ch.codePointAt(0)!
    if (cp > 0xff) list.push({ line, col, char: ch, cp, kind: kindOfChar(cp) })
  }
  return list
}
```
Good.

