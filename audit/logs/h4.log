Now I'll replace exportManifest with CSV version. I'll add `csvCell` and `csvRows` functions. To make the extraction test robust, define the CSV builder as a pure function that produces a string, and exportManifest calls it. I'll write:

```ts
/** RFC 4180 CSV 字段转义：含逗号/引号/换行时整体加引号，内部引号翻倍 */
function csvCell(v: string | number): string {
  const s = String(v ?? '')
  return /[",\r\n]/.test(s) ? `"${s.replace(/"/g, '""')}"` : s
}

/** 生成 CSV 文本（CRLF 行尾，带 UTF-8 BOM 便于表格软件识别中文） */
function buildManifestCsv(): string {
  const rows: Array<Array<string | number>> = [['文件名', '大小(字节)', '算法', '摘要', '状态', '对照结果', '备注']]
  for (const item of items.value) {
    const size = item.file.size
    const exp = normExpected(item)
    if (item.status === 'done') {
      for (const algo of selectedAlgos.value) {
        const r = item.results[algo]
        let verdict = ''
        if (exp && r?.hex) verdict = matchOf(item, algo) ? '一致' : '不一致'
        else if (exp && !r?.hex) verdict = '未计算'
        rows.push([
          item.file.name,
          size,
          algo,
          r?.hex ?? '',
          r?.hex ? '完成' : '部分失败',
          verdict,
          r?.error ?? ''
        ])
      }
    } else if (item.status === 'error') {
      rows.push([item.file.name, size, '', '', '失败', '', Object.values(item.results).find((r) => r?.error)?.error ?? '未知原因'])
    } else if (item.status === 'cancelled') {
      rows.push([item.file.name, size, '', '', '已取消', '', ''])
    } else {
      rows.push([item.file.name, size, '', '', STATUS_LABEL[item.status], '', '未到达终态，未导出摘要'])
    }
  }
  const body = rows.map((r) => r.map(csvCell).join(',')).join('\r\n')
  return '\uFEFF' + body + '\r\n'
}

function exportManifest() {
  downloadText('digest-manifest.csv', buildManifestCsv(), 'text/csv;charset=utf-8')
}
```

