Script:
```ts
<script setup lang="ts">
import { tools } from '~/data/tools'

useSeoMeta({ title: '离线与资源未就绪 · DevKit' })

const online = ref(true)
const visited = ref<string[]>([])
const checking = ref(false)
const lastProbe = ref('')
const lastChecked = ref('')

function loadVisited() {
  try {
    const seen = localStorage.getItem('devkit.visited.v1')
    visited.value = seen ? JSON.parse(seen) : []
  } catch {
    visited.value = []
  }
}

function onOnline() {
  online.value = true
}

function onOffline() {
  online.value = false
  lastProbe.value = ''
}

onMounted(() => {
  online.value = navigator.onLine
  loadVisited()
  window.addEventListener('online', onOnline)
  window.addEventListener('offline', onOffline)
})
onUnmounted(() => {
  window.removeEventListener('online', onOnline)
  window.removeEventListener('offline', onOffline)
})

const visitedTools = computed(() =>
  visited.value
    .map((id) => tools.find((t) => t.id === id))
    .filter((t): t is NonNullable<typeof t> => !!t)
)

async function retry() {
  if (checking.value) return
  checking.value = true
  lastProbe.value = ''
  loadVisited()
  const navOnline = navigator.onLine
  const controller = new AbortController()
  const timer = setTimeout(() => controller.abort(), 4000)
  let reachable = false
  let failure = ''
  try {
    await fetch(`${location.origin}/favicon.ico?_=${Date.now()}`, {
      method: 'HEAD',
      cache: 'no-store',
      signal: controller.signal
    })
    reachable = true
  } catch (e) {
    reachable = false
    failure = errMessage(e)
  } finally {
    clearTimeout(timer)
  }
  online.value = reachable
  lastProbe.value = reachable
    ? `实测可访问本站（navigator.onLine=${navOnline}）`
    : `实测无法访问本站（navigator.onLine=${navOnline}${failure ? `，${failure}` : ''}）`
  lastChecked.value = new Date().toLocaleTimeString()
  checking.value = false
}
</script>
```

