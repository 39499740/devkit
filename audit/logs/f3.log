Let me write it cleanly:

```ts
const online = ref(true)
const visited = ref<string[]>([])
const checking = ref(false)
const probeResult = ref('')
const lastChecked = ref('')

function loadVisited() {
  try {
    const seen = localStorage.getItem('devkit.visited.v1')
    visited.value = seen ? JSON.parse(seen) : []
  } catch {
    visited.value = []
  }
}

let abort: AbortController | null = null

async function checkNow() {
  if (checking.value) return
  checking.value = true
  probeResult.value = ''
  loadVisited()
  const navOnline = navigator.onLine
  let reachable = false
  abort = new AbortController()
  const timer = setTimeout(() => abort?.abort(), 4000)
  try {
    await fetch(`${location.origin}/favicon.ico?_=${Date.now()}`, {
      method: 'HEAD',
      cache: 'no-store',
      signal: abort.signal
    })
    reachable = true
  } catch {
    reachable = false
  } finally {
    clearTimeout(timer)
    abort = null
  }
  online.value = navOnline
  probeResult.value = reachable
    ? '网络请求成功（可访问当前站点）'
    : navOnline
      ? '浏览器报告在线，但站点请求失败（可能无法联网或被拦截）'
      : '浏览器报告离线，站点请求失败'
  lastChecked.value = new Date().toLocaleTimeString()
  if (reachable && !navOnline) online.value = true
  checking.value = false
}
```

Hmm the interplay: online should reflect reality. If reachable, we are online → online.value = true. If not reachable, we're effectively offline regardless of navigator.onLine. That's most honest: `online.value = reachable`. But navigator.onLine could be true while favicon fetch blocked by network? unlikely. Let's set `online.value = reachable` and include navOnline in message. That is a genuine result.

