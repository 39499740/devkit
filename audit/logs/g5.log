```
function locateInEditor(editorRef, line) {
  const el = editorRef.value?.$el?.querySelector('textarea')
  if (!el) return
  const lines = src.value.split('\n')
  let pos = 0
  for (let i=0;i<line-1 && i<lines.length;i++) pos += lines[i].length + 1
  const end = pos + (lines[line-1]?.length ?? 0)
  el.focus()
  el.setSelectionRange(pos, end)
  // scroll
  const lineHeight = parseFloat(getComputedStyle(el).lineHeight) || 20
  el.scrollTop = Math.max(0, (line - 1) * lineHeight - el.clientHeight/2)
}
```
