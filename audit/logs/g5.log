```ts
const ROUND_SIMPLE = new Set(['x','y','x1','y1','x2','y2','cx','cy','r','rx','ry','width','height','fx','fy','offset','stroke-width','stroke-dashoffset','stroke-miterlimit','markerwidth','markerheight','refx','refy','pathlength'])
const ROUND_MULTI = new Set(['d','points','stroke-dasharray','values','keytimes','keysplines'])
const NUM_RE = /-?(?:\d+\.?\d*|\.\d+)(?:[eE][-+]?\d+)?/g

function roundNumber(raw: string, n: number): { out: string; changed: boolean } {
  const num = Number(raw)
  if (!Number.isFinite(num)) return { out: raw, changed: false }
  const factor = 10 ** n
  const rounded = Math.round(num * factor) / factor
  let out = rounded.toFixed(n).replace(/\.?0+$/, '')
  if (out === '-0' || out === '') out = '0'
  return { out, changed: Math.abs(rounded - num) > 1e-12 }
}

function roundAttrValue(val: string, n: number, seen: string[]) {
  const t = val
  return t.replace(NUM_RE, (m) => {
    const r = roundNumber(m, n)
    if (r.changed && seen.length < 3) seen.push(`${m} → ${r.out}`)
    return r.out
  })
}
```

