Implementation of splitTagAttrs:
```ts
function parseTag(rawTag: string): { name: string; attrs: string[]; selfClosed: boolean } | null {
  const m = /^<\s*([a-zA-Z][a-zA-Z0-9:-]*)/.exec(rawTag)
  if (!m) return null
  const name = m[1]!
  const selfClosed = /\/\s*>$/.test(rawTag)
  let rest = rawTag.slice(m[0].length)
  rest = rest.replace(/\/?>$/, '')  // remove trailing > or />
  const attrs: string[] = []
  let i = 0
  while (i < rest.length) {
    while (i < rest.length && /\s/.test(rest[i]!)) i++
    if (i >= rest.length) break
    let start = i
    while (i < rest.length && !/[\s=]/.test(rest[i]!)) i++
    let attr = rest.slice(start, i)
    // skip whitespace
    let j = i
    while (j < rest.length && /\s/.test(rest[j]!)) j++
    if (rest[j] === '=') {
      j++
      while (j < rest.length && /\s/.test(rest[j]!)) j++
      if (rest[j] === '"' || rest[j] === "'") {
        const q = rest[j]!
        j++
        const vs = j
        while (j < rest.length && rest[j] !== q) j++
        attr += '=' + q + rest.slice(vs, j) + q
        j++
      } else {
        const vs = j
        while (j < rest.length && !/\s/.test(rest[j]!)) j++
        attr += '=' + rest.slice(vs, j)
      }
    }
    if (attr) attrs.push(attr)
    i = j
  }
  return { name, attrs, selfClosed }
}
```
This handles quoted values. Good. Then `tagText` for single-line can be built from name+attrs or keep the existing normalized rawTag. I'll keep existing `tagText` for keep mode, and use parseTag for each mode.

Actually, to avoid double parsing, I'll compute `parsed = parseTag(rawTag)` once and use `parsed.attrs` for each mode.

