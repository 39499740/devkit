const outputRows = computed(() => {
  let rows2 = enabledRows.value.slice()
  if (sortMode.value === 'key') {
    rows2 = [...rows2].sort((a,b) => a.key.localeCompare(b.key))
  }
  if (dupMode.value === 'merge') {
    const map = new Map<string, ParamRow>()
    const out: ParamRow[] = []
    for (const r of rows2) {
      if (!r.key) { out.push(r); continue }
      const ex = map.get(r.key)
      if (ex) { ex.value = ex.value + ',' + r.value; ex.hasEq = true }
      else { const c = { ...r }; map.set(r.key, c); out.push(c) }
    }
    return out
  }
  return rows2
})
