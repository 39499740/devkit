```ts
function removeViewBox(text: string): string {
  const m = /<svg\b[^>]*>/i.exec(text)
  if (!m) return text
  const tag = m[0].replace(/\s+viewBox="[^"]*"/i, '')
  return text.slice(0, m.index) + tag + text.slice(m.index + m[0].length)
}
