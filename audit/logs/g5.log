Detection:
```ts
const UNSAFE_TAGS = ['script', 'foreignObject']

function lineOf(haystack: string, needle: string, from = 0): number {
  const idx = haystack.indexOf(needle, from)
  if (idx < 0) return 1
  let line = 1
  for (let i = 0; i < idx; i++) if (haystack[i] === '\n') line++
  return line
}

function scanUnsafe(root: Element, source: string) {
  const items: { kind: string; line: number; snippet: string }[] = []
  for (const tag of UNSAFE_TAGS) {
    const els = Array.from(root.getElementsByTagName(tag))
    for (const el of els) {
      const snip = `<${el.nodeName}>`
      items.push({ kind: tag === 'script' ? 'script 元素' : 'foreignObject 元素', line: lineOf(source, `<${el.nodeName}`), snippet: snip })
    }
  }
  const all = [root, ...Array.from(root.getElementsByTagName('*'))]
  for (const el of all) {
    for (const attr of Array.from(el.attributes)) {
      const name = attr.name
      if (/^on[a-z]+$/i.test(name)) {
        items.push({ kind: `事件属性 ${name}`, line: lineOf(source, name + '='), snippet: `${name}="${attr.value}"` })
      } else if (name === 'href' || name === 'xlink:href') {
        const v = attr.value.trim()
        if (!v.startsWith('#') && !v.startsWith('data:')) {
          items.push({ kind: '外部引用', line: lineOf(source, v), snippet: `${name}="${v}"` })
        }
      }
    }
  }
  return items
}
```

Hmm `lineOf(source, name + '=')` may match a different earlier occurrence. Acceptable.

