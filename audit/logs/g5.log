Rounding function:
```ts
function roundToken(raw: string, n: number): { out: string; changed: boolean } {
  const num = Number(raw)
  if (!Number.isFinite(num)) return { out: raw, changed: false }
  const factor = 10 ** n
  const rounded = Math.round((num + Number.EPSILON) * factor) / factor
  // format: trim trailing zeros
  let s = rounded.toFixed(n).replace(/\.?0+$/, '')
  if (s === '-0') s = '0'
  const changed = rounded !== num
  return { out: s, changed }
}
```
