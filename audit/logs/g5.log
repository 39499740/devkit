genFetch:
```ts
function genFetch(r, notes, unit, lang) {
  if (r.params && r.params.length) notes.push('已将 params 合并进 URL query（fetch/curl 无 params 配置）')
  const url = urlWithParams(r, jsQuote)
  const pad = unit
  if (r.method === 'GET' && !r.body && !r.headers.length) return lang === 'ts' ? `const res: Response = await fetch(${url})` : `fetch(${url})`
  const lines = [lang === 'ts' ? `const res: Response = await fetch(${url}, {` : `fetch(${url}, {`]
  lines.push(`${pad}method: '${r.method}',`)
  if (r.headers.length) {
    lines.push(`${pad}headers: {`)
    for (const h of r.headers) lines.push(`${pad}${pad}${SAFE_KEY.test(h.key) ? h.key : jsQuote(h.key)}: ${jsQuote(h.value)},`)
    lines.push(`${pad}},`)
  }
  if (r.body !== null) {
    if (r.bodyParsed !== null) lines.push(`${pad}body: JSON.stringify(${minifyJson(r.bodyParsed)})`)
    else lines.push(`${pad}body: ${jsQuote(r.body)}`)
  }
  lines.push('})')
  return lines.join('\n')
}
```

genAxios:
```ts
function genAxios(r, unit, lang) {
  const url = urlWithParams(r, jsQuote)
  const open = lang === 'ts' ? `const res: AxiosResponse = await axios({` : `axios({`
  const lines = [open]
  lines.push(`${unit}url: ${url},`)
  lines.push(`${unit}method: '${r.method.toLowerCase()}',`)
  ... headers/params ...
  if (r.body !== null) {
    if (r.bodyParsed !== null) lines.push(`${unit}data: ${prettyJs(r.bodyParsed, unit.length, 1)}`)
    else lines.push(`${unit}data: ${jsQuote(r.body)}`)
  }
  lines.push('})')
  let code = lines.join('\n')
  if (lang === 'ts') code = `import type { AxiosResponse } from 'axios'\n\n${code}`
  return code
}
```
Note `unit.length` for spaces (2 or 4) or tab (1 char)? If unit is '\t', unit.length=1, prettyJs uses ' '.repeat(indent*(depth+1)) → 1 space. That's wrong for tab. But indent options are 2/4 only (no tab) per design. So unit is '  ' or '    ', length 2/4. Good. Actually let me restrict indent to '2'|'4' (no tab) per design.

genCurl:
```ts
function genCurl(r, notes, unit) {
  if (r.params && r.params.length) notes.push('已将 params 合并进 URL query（fetch/curl 无 params 配置）')
  const url = urlWithParams(r, shQuote)
  const lines = [`curl ${url}`]
  if (r.method !== 'GET' || r.body !== null) lines.push(`${unit}-X ${r.method}`)
  for (const h of r.headers) lines.push(`${unit}-H ${shQuote(`${h.key}: ${h.value}`)}`)
  if (r.body !== null) lines.push(`${unit}--data-raw ${shQuote(r.body)}`)
  return lines.join(' \\\n')
}
```

